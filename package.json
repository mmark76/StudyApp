{
  "name": "generic-local-study-app",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check:version": "node scripts/check-version.mjs",
    "package:local": "node scripts/prepare-studyapp-local-package.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark:capacity:calibration": "playwright test --config=playwright.capacity.config.ts --grep @capacity-calibration",
    "benchmark:capacity:safety-smoke": "playwright test --config=playwright.capacity.config.ts --grep @capacity-safety-smoke",
    "benchmark:capacity:smoke": "playwright test --config=playwright.capacity.config.ts --grep @capacity-smoke",
    "benchmark:capacity": "playwright test --config=playwright.capacity.config.ts --grep @capacity-baseline"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
