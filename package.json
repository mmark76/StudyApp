{
  "name": "generic-local-study-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark:capacity:calibration": "playwright test --config=playwright.capacity.config.ts --grep @capacity-calibration",
    "benchmark:capacity:safety-smoke": "playwright test --config=playwright.capacity.config.ts --grep @capacity-safety-smoke",
    "benchmark:capacity:smoke": "playwright test --config=playwright.capacity.config.ts --grep @capacity-smoke",
    "benchmark:capacity": "playwright test --config=playwright.capacity.config.ts --grep @capacity-baseline"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
